# Gitea-specific variables sourced by installer.dsm7 and start-stop-status
# (both look for "$(dirname $0)/service-setup", i.e. this file must live
# next to the shared scripts copied from packages/_shared/spksrc-service/
# at build time). DSM7-only.

SERVICE_PORT=8418
GITEA="${SYNOPKG_PKGDEST}/bin/gitea"
CFG_FILE="${SYNOPKG_PKGVAR}/conf.ini"
PID_FILE="${SYNOPKG_PKGVAR}/gitea.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/gitea.log"

# Gitea shells out to `git` for every repository operation -- depends on
# the separately-installed "Git Server" package (INFO's
# install_dep_packages="git>=2").
PATH="/var/packages/git/target/bin:${PATH}"

ENV="PATH=${PATH} HOME=${SYNOPKG_PKGHOME}"
SERVICE_COMMAND="env ${ENV} ${GITEA} web --port ${SERVICE_PORT} --pid ${PID_FILE}"
SVC_BACKGROUND=y

# Bind the wizard-chosen shared folder (created by the data-share resource
# worker) to the SHARE_NAME/SHARE_PATH the generic installer expects. On DSM7
# a package data-share is linked under /var/packages/<pkg>/shares/<name>.
# Only set on fresh install, when the wizard variable is exported; on upgrade
# these are restored from installer-variables by load_variables_from_file.
if [ -n "${wizard_shared_folder_name}" ]; then
    SHARE_NAME="${wizard_shared_folder_name}"
    SHARE_PATH="/var/packages/${SYNOPKG_PKGNAME}/shares/${wizard_shared_folder_name}"
fi

service_postinst()
{
    if [ "${SYNOPKG_PKG_STATUS}" = "INSTALL" ]; then
        IP=$(ip route get 1 | awk '{print $(NF);exit}')

        sed -i -e "s|@share_path@|${SHARE_PATH}|g" "${CFG_FILE}"
        sed -i -e "s|@ip_address@|${IP:=localhost}|g" "${CFG_FILE}"
        sed -i -e "s|@service_port@|${SERVICE_PORT}|g" "${CFG_FILE}"
    fi
}
